# --- AI weekly coach (api/weekly-review.ts) ---
GEMINI_API_KEY=
# Pin the model; the default alias moves over time.
GEMINI_MODEL=gemini-flash-lite-latest
# Comma-separated origins allowed to call the API. Empty = same host only.
ALLOWED_ORIGINS=
# Per-IP / per-install-token calls allowed per window, and the window in seconds.
AI_RATE_LIMIT=10
AI_RATE_WINDOW_SECONDS=3600
# Hard cap on Gemini calls per UTC day across all users.
AI_DAILY_CALL_CAP=500
# Optional shared rate-limit store (Upstash Redis REST). Without it a per-instance in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
